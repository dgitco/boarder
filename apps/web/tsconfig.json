{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "worker", "vite.config.ts"],
  "exclude": ["worker/**/*.test.ts"]
}
